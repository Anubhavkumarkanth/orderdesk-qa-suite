# Copy these into your shell before running the app or the tests (see README "Quick start").
# Placeholders only: never commit a real password. Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# The password below matches the docker command in the README; change both if you change one.

# The app's database. The app drops and re-seeds every table in it when it starts, so give it its own database.
DATABASE_URL=mysql://root:change-me@127.0.0.1:3306/orderdesk

# The test suite starts the app against this database instead. Keep it separate from DATABASE_URL.
TEST_DATABASE_URL=mysql://root:change-me@127.0.0.1:3306/orderdesk_test
